{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "changyuan-xin-robotics",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "changyuanxin.dpdns.org",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "changyuan-xin-portfolio",
      "database_id": "0f607344-d108-480a-b6c1-35931013fd29",
      "migrations_dir": "./drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "changyuan-xin-portfolio-uploads"
    }
  ],
  "vars": {
    "ADMIN_EMAILS": "unitcirclexin@gmail.com"
  },
  "observability": {
    "enabled": true
  }
}
